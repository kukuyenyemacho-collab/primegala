# Public site URL (no trailing slash). Used for canonical URLs, sitemap, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://primegalahospital.co.ke

# Set to "production" ONLY on the live, client-approved deployment. Anything else is a
# preview: a "Preview" banner is shown and search engines are told not to index it.
NEXT_PUBLIC_SITE_ENV=

# Contact details (Kenyan mobile numbers in any format, e.g. 0712345678). Leave blank until confirmed.
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_PHONE_2=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_HEALTH_EMAIL=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_EMERGENCY_PHONE=

# Facility identifiers (confirm with the facility)
NEXT_PUBLIC_MFL_CODE=
NEXT_PUBLIC_GEO_LAT=
NEXT_PUBLIC_GEO_LNG=
NEXT_PUBLIC_GOOGLE_MAPS_URL=

# Data protection (shown in the Privacy Policy)
NEXT_PUBLIC_ODPC_REGISTRATION=
NEXT_PUBLIC_DPO_CONTACT=

# Social profiles (full URLs)
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# Analytics: only loaded after the visitor accepts analytics cookies
NEXT_PUBLIC_GA_ID=

# Search engine verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Lead delivery into the HMIS (server-side only)
# The site POSTs each lead as JSON (lead envelope + FHIR R4 bundle) signed with HMAC-SHA256.
HMIS_LEADS_WEBHOOK_URL=
HMIS_LEADS_WEBHOOK_SECRET=
# Demo/staging only: accept and log leads (redacted) when no HMIS webhook is configured.
# Never set this in production: patient requests would not reach the front desk.
LEADS_LOG_ONLY=

# Staff image dashboard (/admin, also reached by clicking the big name in the footer)
# Password staff use to sign in. Use a long passphrase.
ADMIN_PASSWORD=
# Optional: separate key for signing sign-in cookies (otherwise derived from the password)
ADMIN_SESSION_SECRET=
# Supabase: dashboard images (storage bucket "media") and booking requests (table "leads").
# Apply supabase/migrations first. The URL is public; the SECRET key is server-only: set it in
# Vercel, never in code or a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Local testing only: store uploads in .media-local/ instead of Supabase
MEDIA_STORAGE=
